# Server-only backend origin. Keep this at the origin; the API paths already
# include /api/v1 in the generated OpenAPI contract.
COMPASS_API_BASE_URL=https://localhost:8443

# Local staging only: path to the generated Caddy root CA. Set this in the
# shell before `pnpm start:local`; Next.js must receive it before Node starts.
# COMPASS_LOCAL_STAGING_CA_CERT=/path/to/compass-local-staging-caddy-root.crt

# Deployment environment used by server-side route guards.
COMPASS_ENVIRONMENT=development

# Deployment-specific branding fallbacks used only when public configuration is
# unavailable or a particular field is empty.
COMPASS_DEFAULT_INSTITUTION_NAME=University of Camarines Norte
COMPASS_DEFAULT_OFFICE_NAME=Guidance and Counseling Office

# Keep the internal component showcase off in production.
# Staging may enable it with COMPASS_COMPONENT_SHOWCASE_ENABLED=true.
COMPASS_COMPONENT_SHOWCASE_ENABLED=false
